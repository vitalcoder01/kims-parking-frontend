<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides react-native-blob-util's bundled default of the same name —
     kept identical to it (external/files/cache paths) so its FileProvider
     keeps working exactly as the library expects. App-module resources win
     over library ones on a name collision, so this is what actually applies. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path
        name="external_files"
        path="." />
    <files-path
        name="files-path"
        path="." />
    <cache-path
        name="cache-path"
        path="." />
</paths>
