{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "skipLibCheck": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": []
  },
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "__tests__",
    "scripts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
